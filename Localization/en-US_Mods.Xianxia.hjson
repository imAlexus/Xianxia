Configs: {
	CultivationServerConfig: {
		DisplayName: Xianxia - Server Settings

		EnableTimeAcceleration: {
			Label: Accelerate time while meditating
			Tooltip: If enabled, world time advances faster while at least one player is meditating
		}

		TimeMultiplier: {
			Label: Time multiplier
			Tooltip: Controls how quickly day and night pass during meditation
		}

		Headers: {
			SpiritualQiZones: High spiritual Qi zones
			SpiritBeasts: Spirit Beasts
			Debug: Debug tools
			AbilityTerrainDestruction: Ability world destruction
		}

		EnableSpiritualQiZones: {
			Label: Enable spiritual Qi zones
			Tooltip: Spirit Crystal veins increase meditation and passive recovery nearby
		}

		SpiritualQiZoneRadiusBlocks: {
			Label: Zone radius in blocks
			Tooltip: Maximum distance at which Spirit Crystals increase Qi gain
		}

		SpiritMineDetectorRadiusBlocks: {
			Label: Spirit Vein Compass radius
			Tooltip: Maximum distance in blocks within which the compass can detect a Spirit Stone vein
		}

		EnableSpiritBeasts: {
			Label: Enable Spirit Beasts
			Tooltip: Allows natural spawning of cultivation beasts in suitable biomes
		}

		EnableSpiritBeastDistanceScaling: {
			Label: Scale Spirit Beasts with distance
			Tooltip: Stronger Realms and higher Stages appear progressively farther from the shared world spawn
		}

		SpiritBeastSpawnRatePercent: {
			Label: Spirit Beast spawn rate
			Tooltip: Percentage multiplier applied to Spirit Beast natural spawn chances
		}

		EnableDebugCommandsInMultiplayer: {
			Label: Enable debug commands in multiplayer
			Tooltip: Allows every player on this test server to use /xiadebug. Keep disabled on public servers
		}

		EnableAbilityTerrainDestruction: {
			Label: Enable world destruction
			Tooltip: Master switch allowing offensive abilities to break tiles
		}

		EnableFireballTerrainDestruction: {
			Label: Fireball
			Tooltip: Allows Fireball to break terrain on impact
		}

		EnableQiPalmTerrainDestruction: {
			Label: Qi Palm
			Tooltip: Allows Qi Palm to break terrain on impact
		}

		EnableFlameStepTerrainDestruction: {
			Label: Flame Step
			Tooltip: Allows Flame Step to break terrain on impact
		}
	}

	CultivationClientConfig: {
		DisplayName: Xianxia - Interface and Effects

		Headers: {
			MeditationControls: Meditation controls
			QiHud: Qi HUD
			VisualEffects: Visual effects
		}

		ToggleMeditation: {
			Label: Toggle meditation
			Tooltip: Press the meditation key once to begin and again to stop. Disable this option to require holding the key
		}

		QiBarHorizontalPositionPercent: {
			Label: Qi bar horizontal position
			Tooltip: 0 places the bar on the left, 50 in the center and 100 on the right
		}

		QiBarVerticalPosition: {
			Label: Qi bar vertical position
			Tooltip: Distance in pixels from the top edge of the screen
		}

		QiBarScalePercent: {
			Label: Qi bar scale
			Tooltip: Changes the size of the Qi bar and its text
		}

		ShowQiConcentration: {
			Label: Show Qi Concentration
			Tooltip: Shows the nearby Spirit Stone concentration below the Qi bar
		}

		VisualEffectIntensityPercent: {
			Label: Visual effect intensity
			Tooltip: Controls Xianxia particles, spiritual lights, auras and projectile trails without changing gameplay
		}
	}
}

Items: {
	SpiritVeinCompass: {
		DisplayName: Spirit Vein Compass
		Tooltip:
			'''
			Searches for the nearest Spirit Crystal vein
			Default range: 250 blocks, configurable by the server
			Shows its direction and distance for 10 seconds
			'''
		Found: Spirit Stone vein detected {0} blocks away
		NotFound: No Spirit Stone vein detected within {0} blocks
		Distance: "{0} blocks"
	}

	ResonantSpiritVeinCompass: {
		DisplayName: Resonant Spirit Vein Compass
		Tooltip: Upgraded version: +200 blocks to the configured range
	}


			}

			Tier0: Protection Formation | 1 simultaneous array slot
			Tier1: Unlock Spirit Gathering | 2 simultaneous array slots
			Tier2: Unlock Suppression | retain 2 simultaneous array slots
			Tier3: Unlock Restoration | 3 simultaneous array slots
			Tier4: Grand Formation | all 4 array types can operate together
		}
	}


Buffs: {
	QiResistanceBuff: {
		DisplayName: Qi Resistance
		Description: +10 defense
	}

	SpiritGatheringBuff: {
		DisplayName: Spiritual Circulation
		Description: +2 passive Qi/s and +2 meditation Qi/s
	}

	BodyTemperingBuff: {
		DisplayName: Body Tempering
		Description: +8 defense and +10% melee damage
	}

	SpiritualPressureDebuff: {
		DisplayName: Spiritual Oppression
		Description: Movement slowed by the pressure of a superior cultivator
	}

	BeastBloodTemperingBuff: {
		DisplayName: Beast Blood Tempering
		Description: +12 defense, +10% damage and +5% damage reduction
	}

	FlameMeridianBuff: {
		DisplayName: Flame Meridian
		Description: +18% magic damage and immunity to fire
	}

	ThunderResistanceBuff: {
		DisplayName: Thunder Resistance
		Description: +20 defense, +12% damage reduction and immunity to Electrified
	}

	CoreRefinementBuff: {
		DisplayName: Core Refinement
		Description: +12 passive Qi/s and +12 meditation Qi/s
	}

	FoundationStabilizationBuff: {
		DisplayName: Foundation Stabilization
		Description: +15 defense, +4 life regeneration and 10% less Tribulation damage
	}

	GoldenCoreTemperingBuff: {
		DisplayName: Golden Core Tempering
		Description: +15% damage and 10% lower Qi costs
	}

	NascentSoulAwakeningBuff: {
		DisplayName: Nascent Soul Awakening
		Description: +8 life regeneration, +10% magic damage and stronger Nascent Soul techniques
	}

	SoulNourishingBuff: {
		DisplayName: Soul Nourishment
		Description: Greatly regenerates life and restores 0.5% maximum Qi per second
	}

	VoidInsightBuff: {
		DisplayName: Void Insight
		Description: 18% lower Qi costs and 25% shorter Flame Step and Void Step cooldowns
	}

	HeavenlyRebirthBuff: {
		DisplayName: Heavenly Rebirth
		Description: Prevents one death and restores 25% life
	}

	TribulationWardBuff: {
		DisplayName: Tribulation Ward
		Description: +10 defense, 25% less Tribulation damage and 20% lower Tribulation shield cost
	}

	SpiritBeastLureBuff: {
		DisplayName: Spirit Beast Lure
		Description: Greatly increases the appearance of Spirit Beasts
	}

	ConcealmentBuff: {
		DisplayName: Spiritual Concealment
		Description: Greatly reduces enemy attention and natural spawning
	}

	PermanentFormationProtectionBuff: {
		DisplayName: Permanent Formation Protection
		Description: Protected by a territorial array: +12 defense and 6% damage reduction
	}

	PermanentFormationGatheringBuff: {
		DisplayName: Spirit Gathering Formation
		Description: Meditation and passive Qi recovery are increased by 50%
	}

	PermanentFormationSuppressionBuff: {
		DisplayName: Suppression Formation
		Description: Hostile creatures within the territory are slowed and weakened
	}

	PermanentFormationRestorationBuff: {
		DisplayName: Restoration Formation
		Description: The territorial array continuously restores life
	}

	PermanentFormationRelayProtectionBuff: {
		DisplayName: Focused Relay Protection
		Description: Exclusive Relay mode grants +24 defense and 12% damage reduction
	}

	PermanentFormationRelayGatheringBuff: {
		DisplayName: Focused Relay Gathering
		Description: Relay specialization raises meditation and passive Qi recovery to 125% bonus
	}

	PermanentFormationRelaySuppressionBuff: {
		DisplayName: Focused Relay Suppression
		Description: Exclusive Relay mode strongly slows and weakens hostile creatures
	}

	PermanentFormationRelayRestorationBuff: {
		DisplayName: Focused Relay Restoration
		Description: Exclusive Relay mode grants +20 life regeneration
	}

	SectProtectionFormationBuff: {
		DisplayName: Sect Protection Formation
		Description: Repels enemies and absorbs damage with its own barrier before Qi Protection
	}
}


	GoldenCoreEffect: Level {0} | -5% ability costs, then -1% per level | {1}
	NascentSoulEffect: Level {0} | +4 life regeneration, then +2 per level | {1}
	NightVisionEffect: Level {0} | larger light radius; costs 3 Qi/s, 2 at level 8 and 1 at level 15 | {1}
	SwordIntentEffect: Level {0} | Flying Sword damage increases by 10%, then 1.5% per level | {1}
	SwordRainEffect: Level {0} | five swords, cursor-controlled range, higher damage and lower Qi cost/cooldown | {1}
	FormationEffect: Level {0} | maintained with Qi; allies can meditate inside to reinforce and repair it | {1}

	Tabs: {
		Abilities: Abilities
		Paths: Paths
		Sect: Sect
	}

	Paths: {
		Title: Professions
		Available: AVAILABLE

	VoidInsightPill: {
		DisplayName: Pillola della Comprensione del Vuoto
		Tooltip: Riduce i costi Qi del 18% e i cooldown di movimento del 25% per 5 minuti
	}

	HeavenlyRebirthPill: {
		DisplayName: Pillola della Rinascita Celeste
		Tooltip: Previene una morte e ripristina il 25% della vita; dura fino a 10 minuti
	}

	TribulationWardPill: {

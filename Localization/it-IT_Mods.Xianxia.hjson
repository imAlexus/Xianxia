Buffs: {
	QiResistanceBuff: {
		DisplayName: Resistenza Qi
		Description: +10 difesa
	}

	SpiritGatheringBuff: {
		DisplayName: Circolazione Spirituale
		Description: +2 Qi/s passivi e +2 Qi/s durante la meditazione
	}

	BodyTemperingBuff: {
		DisplayName: Temperamento Corporeo
		Description: +8 difesa e +10% danno melee
	}

	SpiritualPressureDebuff: {
		DisplayName: Oppressione Spirituale
		Description: Movimento rallentato dalla pressione di un coltivatore superiore
	}

	BeastBloodTemperingBuff: {
		DisplayName: Temperamento del Sangue Bestiale
		Description: +12 difesa, +10% danni e +5% riduzione del danno
	}

	FlameMeridianBuff: {
		DisplayName: Meridiano della Fiamma
		Description: +18% danni magici e immunita al fuoco
	}

	ThunderResistanceBuff: {
		DisplayName: Resistenza al Tuono
		Description: +20 difesa, +12% riduzione del danno e immunita a Elettrificato
	}

	CoreRefinementBuff: {
		DisplayName: Raffinazione del Nucleo
		Description: +12 Qi/s passivo e +12 Qi/s in meditazione
	}

	FoundationStabilizationBuff: {
		DisplayName: Stabilizzazione della Fondazione
		Description: +15 difesa, +4 rigenerazione vita e 10% danni in meno dalle Tribulation
	}

	GoldenCoreTemperingBuff: {
		DisplayName: Temperamento del Nucleo Dorato
		Description: +15% danni e costi Qi ridotti del 10%
	}

	NascentSoulAwakeningBuff: {
		DisplayName: Risveglio dell'Anima Nascente
		Description: +8 rigenerazione vita, +10% danni magici e tecniche Nascent Soul potenziate
	}

	SoulNourishingBuff: {
		DisplayName: Nutrimento dell'Anima
		Description: Rigenera fortemente la vita e recupera lo 0.5% del Qi massimo al secondo
	}

	VoidInsightBuff: {
		DisplayName: Comprensione del Vuoto
		Description: Costi Qi ridotti del 18% e cooldown di Flame Step e Void Step ridotti del 25%
	}

	HeavenlyRebirthBuff: {
		DisplayName: Rinascita Celeste
		Description: Previene una morte e ripristina il 25% della vita
	}

	TribulationWardBuff: {
		DisplayName: Protezione dalla Tribulation
		Description: +10 difesa, 25% danni Tribulation in meno e costo scudo ridotto del 20%
	}

	SpiritBeastLureBuff: {
		DisplayName: Richiamo delle Bestie Spirituali
		Description: Aumenta notevolmente la comparsa delle Bestie Spirituali
	}

	ConcealmentBuff: {
		DisplayName: Occultamento Spirituale
		Description: Riduce notevolmente l'attenzione e la generazione dei nemici
	}
}


Configs: {
	CultivationServerConfig: {
		DisplayName: Xianxia - Impostazioni Server

		EnableTimeAcceleration: {
			Label: Accelera il tempo durante la meditazione
			Tooltip: Se attivo, il tempo del mondo avanza piu velocemente quando almeno un giocatore medita
		}

		TimeMultiplier: {
			Label: Moltiplicatore del tempo
			Tooltip: Determina quanto velocemente trascorrono giorno e notte durante la meditazione
		}

		Headers: {
			SpiritualQiZones: Zone ad alta concentrazione di Qi
			SpiritBeasts: Bestie Spirituali
			Debug: Strumenti di debug
			AbilityTerrainDestruction: Distruzione del mondo tramite abilita
		}

		EnableSpiritualQiZones: {
			Label: Abilita zone di Qi spirituale
			Tooltip: Le vene di Cristallo Spirituale aumentano meditazione e recupero passivo nelle vicinanze
		}

		SpiritualQiZoneRadiusBlocks: {
			Label: Raggio delle zone in blocchi
			Tooltip: Distanza massima alla quale i Cristalli Spirituali aumentano il guadagno di Qi
		}

		SpiritMineDetectorRadiusBlocks: {
			Label: Raggio della Bussola Cercavene
			Tooltip: Distanza massima in blocchi entro cui la bussola puo rilevare una vena di Spirit Stone
		}

		EnableSpiritBeasts: {
			Label: Abilita Bestie Spirituali
			Tooltip: Permette la comparsa naturale delle bestie di coltivazione nei biomi adatti
		}

		EnableSpiritBeastDistanceScaling: {
			Label: Scala le Bestie Spirituali con la distanza
			Tooltip: Realm piu forti e Stadi superiori compaiono progressivamente piu lontano dallo spawn condiviso del mondo
		}

		SpiritBeastSpawnRatePercent: {
			Label: Frequenza delle Bestie Spirituali
			Tooltip: Moltiplicatore percentuale applicato alla probabilita di comparsa naturale
		}

		EnableDebugCommandsInMultiplayer: {
			Label: Abilita comandi debug in multiplayer
			Tooltip: Permette a ogni giocatore del server di test di usare /xiadebug. Tienilo disabilitato sui server pubblici
		}

		EnableAbilityTerrainDestruction: {
			Label: Abilita distruzione del mondo
			Tooltip: Interruttore globale per consentire alle abilita offensive di rompere i blocchi
		}

		EnableFireballTerrainDestruction: {
			Label: Palla di Fuoco
			Tooltip: Permette alla Palla di Fuoco di rompere il terreno all'impatto
		}

		EnableQiPalmTerrainDestruction: {
			Label: Palmo del Qi
			Tooltip: Permette al Palmo del Qi di rompere il terreno all'impatto
		}

		EnableFlameStepTerrainDestruction: {
			Label: Passo di Fiamma
			Tooltip: Permette al Passo di Fiamma di rompere il terreno all'impatto
		}
	}

	CultivationClientConfig: {
		DisplayName: Xianxia - Interfaccia ed Effetti

		Headers: {
			MeditationControls: Controlli della meditazione
			QiHud: Interfaccia del Qi
			VisualEffects: Effetti visivi
		}

		ToggleMeditation: {
			Label: Meditazione a interruttore
			Tooltip: Premi una volta il tasto di meditazione per iniziare e di nuovo per fermarti. Disattiva questa opzione per dover tenere premuto il tasto
		}

		QiBarHorizontalPositionPercent: {
			Label: Posizione orizzontale della barra Qi
			Tooltip: 0 posiziona la barra a sinistra, 50 al centro e 100 a destra
		}

		QiBarVerticalPosition: {
			Label: Posizione verticale della barra Qi
			Tooltip: Distanza in pixel dal bordo superiore dello schermo
		}

		QiBarScalePercent: {
			Label: Scala della barra Qi
			Tooltip: Modifica la dimensione della barra Qi e del suo testo
		}

		ShowQiConcentration: {
			Label: Mostra Concentrazione Qi
			Tooltip: Mostra la concentrazione di Spirit Stone nelle vicinanze sotto la barra Qi
		}

		VisualEffectIntensityPercent: {
			Label: Intensita degli effetti visivi
			Tooltip: Regola particelle, luci spirituali, aure e scie di Xianxia senza modificare il gameplay
		}
	}
}


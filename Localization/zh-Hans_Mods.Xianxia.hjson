	}

	SpiritGatheringBuff: {
		DisplayName: 灵气周天
		Description: 被动真气恢复 +2/秒，冥想真气恢复 +2/秒
	}

	BodyTemperingBuff: {
		DisplayName: 淬体
		Description: +8 防御，+10% 近战伤害
	}

	SpiritualPressureDebuff: {

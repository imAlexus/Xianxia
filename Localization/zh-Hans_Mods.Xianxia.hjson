Buffs: {
	QiResistanceBuff: {
		DisplayName: 真气护体
		Description: +10 防御
	}

	SpiritGatheringBuff: {
		DisplayName: 灵气周天
		Description: 被动真气恢复 +2/秒，冥想真气恢复 +2/秒
	}

	BodyTemperingBuff: {
		DisplayName: 淬体
		Description: +8 防御，+10% 近战伤害
	}

	SpiritualPressureDebuff: {
		DisplayName: 灵压压制
		Description: 受到高阶修士的灵压，移动速度降低
	}

	BeastBloodTemperingBuff: {
		DisplayName: 兽血淬体
		Description: +12 防御，+10% 伤害，+5% 伤害减免
	}

	FlameMeridianBuff: {
		DisplayName: 炎脉
		Description: +18% 魔法伤害并免疫火焰
	}

	ThunderResistanceBuff: {
		DisplayName: 雷霆抗性
		Description: +20 防御，+12% 伤害减免并免疫带电
	}

	CoreRefinementBuff: {
		DisplayName: 丹核淬炼
		Description: 被动真气恢复 +12/秒，冥想真气恢复 +12/秒
	}

	FoundationStabilizationBuff: {
		DisplayName: 稳固道基
		Description: +15 防御，+4 生命再生，天劫伤害降低 10%
	}

	GoldenCoreTemperingBuff: {
		DisplayName: 金丹淬炼
		Description: +15% 伤害，真气消耗降低 10%
	}

	NascentSoulAwakeningBuff: {
		DisplayName: 元婴觉醒
		Description: +8 生命再生，+10% 魔法伤害并强化元婴功法
	}

	SoulNourishingBuff: {
		DisplayName: 养魂
		Description: 大幅恢复生命，每秒恢复 0.5% 最大真气
	}

	VoidInsightBuff: {
		DisplayName: 虚空感悟
		Description: 真气消耗降低 18%，炎步与虚空步冷却缩短 25%
	}

	HeavenlyRebirthBuff: {
		DisplayName: 天命重生
		Description: 抵消一次死亡并恢复 25% 生命
	}

	TribulationWardBuff: {
		DisplayName: 渡劫护符
		Description: +10 防御，天劫伤害降低 25%，天劫护盾消耗降低 20%
	}

	SpiritBeastLureBuff: {
		DisplayName: 灵兽诱引
		Description: 大幅提高灵兽出现率
	}

	ConcealmentBuff: {
		DisplayName: 隐匿气息
		Description: 大幅降低敌人注意力和自然生成率
	}
}


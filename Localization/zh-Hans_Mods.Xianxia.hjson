Configs: {
	CultivationServerConfig: {
		DisplayName: Xianxia - 服务器设置

		EnableTimeAcceleration: {
			Label: 冥想时加速时间
			Tooltip: 开启后，至少一名玩家冥想时世界时间会加速
		}

		TimeMultiplier: {
			Label: 时间倍率
			Tooltip: 控制冥想时昼夜流逝速度
		}

		Headers: {
			SpiritualQiZones: 高灵气区域
			SpiritBeasts: 灵兽
			Debug: 调试工具
			AbilityTerrainDestruction: 功法地形破坏
		}

		EnableSpiritualQiZones: {
			Label: 启用高灵气区域
			Tooltip: 灵晶矿脉可提高附近的冥想与被动恢复
		}

		SpiritualQiZoneRadiusBlocks: {
			Label: 区域半径（格）
			Tooltip: 灵晶提高真气获取的最大距离
		}

		SpiritMineDetectorRadiusBlocks: {
			Label: 寻灵罗盘半径
			Tooltip: 罗盘可探测灵石矿脉的最大距离（格）
		}

		EnableSpiritBeasts: {
			Label: 启用灵兽
			Tooltip: 允许修炼灵兽在合适的生物群系自然生成
		}

		EnableSpiritBeastDistanceScaling: {
			Label: 灵兽随距离增强
			Tooltip: 距离世界公共出生点越远，出现的境界与阶段越高
		}

		SpiritBeastSpawnRatePercent: {
			Label: 灵兽生成率
			Tooltip: 应用于灵兽自然生成概率的百分比倍率
		}

		EnableDebugCommandsInMultiplayer: {
			Label: 多人模式启用调试命令
			Tooltip: 允许测试服务器上的所有玩家使用 /xiadebug。公共服务器请保持关闭
		}

		EnableAbilityTerrainDestruction: {
			Label: 启用世界破坏
			Tooltip: 允许攻击性功法破坏图格的总开关
		}

		EnableFireballTerrainDestruction: {
			Label: 火球术
			Tooltip: 允许火球术命中时破坏地形
		}

		EnableQiPalmTerrainDestruction: {
			Label: 真气掌
			Tooltip: 允许真气掌命中时破坏地形
		}

		EnableFlameStepTerrainDestruction: {
			Label: 炎步
			Tooltip: 允许炎步命中时破坏地形
		}
	}

	CultivationClientConfig: {
		DisplayName: Xianxia - 界面与特效

		Headers: {
			MeditationControls: 冥想控制
			QiHud: 真气界面
			VisualEffects: 视觉特效
		}

		ToggleMeditation: {
			Label: 切换式冥想
			Tooltip: 按一次冥想键开始，再按一次停止。关闭后需持续按住按键
		}

		QiBarHorizontalPositionPercent: {
			Label: 真气条水平位置
			Tooltip: 0 位于左侧，50 位于中央，100 位于右侧
		}

		QiBarVerticalPosition: {
			Label: 真气条垂直位置
			Tooltip: 距屏幕顶端的像素距离
		}

		QiBarScalePercent: {
			Label: 真气条缩放
			Tooltip: 调整真气条及其文字大小
		}

		ShowQiConcentration: {
			Label: 显示灵气浓度
			Tooltip: 在真气条下显示附近灵石浓度
		}

		VisualEffectIntensityPercent: {
			Label: 视觉特效强度
			Tooltip: 调整 Xianxia 的粒子、灵光、光环与弹道，不影响玩法
		}
	}
}

